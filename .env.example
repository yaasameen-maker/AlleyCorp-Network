ENV=development

# ── Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=

# ── MCP Security ──────────────────────────────────────────────────────
# Layer 2: Token signing secret — generate with: openssl rand -hex 32
# Never commit this value. Rotate if exposed.
MCP_TOKEN_SECRET=

# Layer 3: MCP server port — binds to 127.0.0.1 only, never 0.0.0.0
MCP_PORT=3001

# Layer 4: Sandbox root — all file reads constrained to this directory
# Use an absolute path in production
MCP_SANDBOX_DIR=./data

# ── App ───────────────────────────────────────────────────────────────
SENTRY_DSN=
APP_SECRET_KEY=

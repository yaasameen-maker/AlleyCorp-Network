ENV=development

# ── Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Exa (neural web search — signal ingestion + fund enrichment) ──────
EXA_API_KEY=

# ── Enrichment pipeline ───────────────────────────────────────────────
# Days before a fund's contacts are considered stale and re-enriched.
# Default: 30. Lower = more frequent re-checks, more Exa credits used.
ENRICH_MAX_AGE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=

# ── MCP Security ──────────────────────────────────────────────────────
# Layer 2: Token signing secret — generate with: openssl rand -hex 32
# Never commit this value. Rotate if exposed.
MCP_TOKEN_SECRET=

# Layer 3: MCP server port — binds to 127.0.0.1 only, never 0.0.0.0
MCP_PORT=3001

# Layer 4: Sandbox root — all file reads constrained to this directory
# Use an absolute path in production
MCP_SANDBOX_DIR=./data

# ── Resend (daily digest email) ───────────────────────────────────────
# API key from resend.com — verify a sending domain before use
RESEND_API_KEY=
# Verified sender address (must match your Resend domain)
DIGEST_FROM_EMAIL=digest@alleycorp.vc
# Recipient for the daily digest (Abe, Brannon, etc.)
DIGEST_RECIPIENT_EMAIL=
# Base URL for deep-links in the digest email (no trailing slash)
APP_URL=https://alleycorp-network.up.railway.app

# ── App ───────────────────────────────────────────────────────────────
SENTRY_DSN=
APP_SECRET_KEY=
